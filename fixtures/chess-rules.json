        "chess-20-legal-moves-ep-gone",
        "chess-21-create-ep-game",
        "chess-22-en-passant-capture",
        "chess-23-create-promo-q",
        "chess-24-promotion-queen",
        "chess-25-create-promo-n",
        "chess-26-underpromotion-knight",
