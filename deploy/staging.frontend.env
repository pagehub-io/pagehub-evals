# pagehub-evals — staging frontend (Cloudflare Pages) overrides.
#
# WHEN TO ADD A KEY HERE: any value the Expo web build needs at compile
# time that should NOT live in deploy/staging.env (which goes to the
# Vercel API runtime).
#
# WHEN NOT TO ADD: anything deploy-cloudflare.yml@v1 already injects:
#   API_URL, EXPO_PUBLIC_API_URL                — Vercel API URL
#   APP_RELEASE, EXPO_PUBLIC_APP_RELEASE        — git tag
#   SENTRY_DSN, EXPO_PUBLIC_SENTRY_DSN          — Sentry per-(app, env)
#   SENTRY_RELEASE, SENTRY_ENVIRONMENT          — Sentry release metadata
#   SENTRY_AUTH_TOKEN                           — sourcemap upload auth

# pagehub support backend — the SupportWidget POSTs /tickets here.
EXPO_PUBLIC_PAGEHUB_API_URL=https://pagehub-staging.vercel.app
