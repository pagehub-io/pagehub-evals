# pagehub-evals — staging environment overrides.
# See deploy/README.md for what belongs here vs. GitHub Secrets.

# APP_URL is the user-visible Cloudflare Pages site (where the Expo web
# bundle is served), NOT the Vercel API URL. Drives the CORS allowlist
# (browser sends Origin: <site>) and any links the operator surface
# emits.
APP_URL=https://staging.pagehub-evals-app.pages.dev

# Explicit pagehub-auth registry endpoint + JWT issuer. Redundant with
# AUTH_SERVICE_URL but makes this file the single source of truth.
PAGEHUB_AUTH_BASE_URL=https://pagehub-auth-staging.vercel.app
PAGEHUB_AUTH_ISSUER=https://pagehub-auth-staging.vercel.app

# Operator allowlist — comma-separated emails that gate /admin/*.
# Required in staging/production (boot fails closed if empty).
ADMIN_EMAILS=support@pagehub.io

# Operational kill switch. Default true once the resource ships.
RUNS_ENABLED=true
