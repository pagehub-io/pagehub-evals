# Copy to .env.local for local dev. Real secrets never commit.
#
# Every var below is REQUIRED — api/config.py refuses to boot if any
# is missing. There are no fallback defaults.

# Identity / environment gate
ENVIRONMENT=development
GIT_SHA=dev
APP_URL=http://localhost:8002
APP_SLUG=pagehub-evals

# Auth (HS256 shared signing key with pagehub-auth)
JWT_SIGNING_KEYS=dev-kid:local-dev-jwt-signing-key-DO-NOT-USE-IN-PROD
PAGEHUB_AUTH_BASE_URL=http://localhost:8080
PAGEHUB_AUTH_ISSUER=http://localhost:8080
SERVICE_API_KEY=local-dev-service-api-key

# Storage
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5533/pagehub_evals

# Fernet key for environment-secrets encryption.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Operator allowlist
ADMIN_EMAILS=support@pagehub.io

# Feature flags
RUNS_ENABLED=true

# Observability — both genuinely OPTIONAL (absence disables Sentry).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
